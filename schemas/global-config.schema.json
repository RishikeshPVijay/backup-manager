{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://backup-manager.local/schemas/global-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "state",
    "storage"
  ],
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "anchor_path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "anchor_path": {
          "type": "string",
          "pattern": "^/"
        }
      }
    },
    "restic": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "executable": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_jobs": {
          "type": "integer",
          "minimum": 1
        },
        "job_timeout_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "operation_timeout_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "cleanup_timeout_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "release_timeout_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "acquire_timeout_seconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "logging": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "level": {
          "enum": [
            "DEBUG",
            "INFO",
            "WARNING",
            "ERROR"
          ]
        },
        "history_days": {
          "type": "integer",
          "minimum": 1
        },
        "history_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "storage": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "provider",
          "lifecycle",
          "config"
        ],
        "properties": {
          "provider": {
            "type": "string",
            "minLength": 1
          },
          "lifecycle": {
            "enum": [
              "always_on",
              "on_demand"
            ]
          },
          "coordination_id": {
            "type": "string",
            "minLength": 1
          },
          "config": {
            "type": "object"
          }
        }
      },
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_-]{0,63}$"
      }
    },
    "notifications": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "job": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "executable"
            ],
            "properties": {
              "executable": {
                "type": "string",
                "minLength": 1
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "cwd": {
                "type": "string",
                "pattern": "^/"
              },
              "timeout_seconds": {
                "type": "integer",
                "minimum": 1
              },
              "env": {
                "type": "object",
                "propertyNames": {
                  "pattern": "^(?!BACKUP_MANAGER_)[A-Za-z_][A-Za-z0-9_]*$"
                },
                "additionalProperties": {
                  "type": "string"
                }
              },
              "secrets": {
                "type": "object",
                "propertyNames": {
                  "pattern": "^(?!BACKUP_MANAGER_)[A-Za-z_][A-Za-z0-9_]*$"
                },
                "additionalProperties": {
                  "$ref": "#/$defs/secretReference"
                }
              },
              "user": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "string",
                    "minLength": 1
                  }
                ]
              },
              "group": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "string",
                    "minLength": 1
                  }
                ]
              }
            }
          }
        },
        "storage": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "executable"
            ],
            "properties": {
              "executable": {
                "type": "string",
                "minLength": 1
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "cwd": {
                "type": "string",
                "pattern": "^/"
              },
              "timeout_seconds": {
                "type": "integer",
                "minimum": 1
              },
              "env": {
                "type": "object",
                "propertyNames": {
                  "pattern": "^(?!BACKUP_MANAGER_)[A-Za-z_][A-Za-z0-9_]*$"
                },
                "additionalProperties": {
                  "type": "string"
                }
              },
              "secrets": {
                "type": "object",
                "propertyNames": {
                  "pattern": "^(?!BACKUP_MANAGER_)[A-Za-z_][A-Za-z0-9_]*$"
                },
                "additionalProperties": {
                  "$ref": "#/$defs/secretReference"
                }
              },
              "user": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "string",
                    "minLength": 1
                  }
                ]
              },
              "group": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "string",
                    "minLength": 1
                  }
                ]
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "secretReference": {
      "type": "object",
      "required": [
        "provider"
      ],
      "properties": {
        "provider": {
          "enum": [
            "file",
            "environment"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "variable": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "provider": {
                "const": "file"
              }
            }
          },
          "then": {
            "required": [
              "path"
            ],
            "not": {
              "required": [
                "variable"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "provider": {
                "const": "environment"
              }
            }
          },
          "then": {
            "required": [
              "variable"
            ],
            "not": {
              "required": [
                "path"
              ]
            }
          }
        }
      ]
    }
  }
}
