{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Backup Manager CLI result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "command",
    "status",
    "operation_id",
    "data",
    "errors"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "command": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "full",
        "partial",
        "failed",
        "cancelled",
        "invalid",
        "busy",
        "unsupported",
        "unsafe",
        "error"
      ]
    },
    "operation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "data": {
      "type": "object"
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message",
          "context"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "context": {
            "type": "object"
          }
        }
      }
    }
  }
}
